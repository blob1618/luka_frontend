APP_ENV=development
APP_BASE_URL=http://localhost:8000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
AUTH_COOKIE_SECURE=false
ENABLE_MOCK_AUTH=true

# Application secrets and local dashboard data
SECRET_KEY=change-me-to-a-random-secret-in-production
# Used only by /dev-login (requires ENABLE_MOCK_AUTH=true) to seed a fake
# session — the linked Usuario row for this id must exist for the dashboard
# to actually show data locally.
MOCK_AUTH_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wewtbqfbnymyvvxzrmbg.supabase.co:6543/postgres
